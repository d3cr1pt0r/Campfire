# npm run server loads .env if present. Shell environment variables take precedence.
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
SERVER_NAME=My Driskord server
# Comma-separated additional browser-client origins. Localhost clients are allowed.
CLIENT_ORIGINS=https://chat.example.com
# Provide your own STUN and TURN service for calls across the internet.
# Short-lived TURN credentials are recommended for public hosting.
# STUN-only connectivity test (no media relay):
# ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
ICE_SERVERS=[]
