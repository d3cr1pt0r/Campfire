# npm run server loads .env if present. Shell environment variables take precedence.
PORT=3001
HOST=0.0.0.0
# Holds the community database and the server identity key (identity/). Back it up.
DATA_DIR=./data
SERVER_NAME=My Campfire server
# Public IP or hostname (no scheme or port). Used in printed server/setup links and the
# server's own certificate.
PUBLIC_ADDRESS=

# Transport encryption. By default Campfire serves HTTPS (TLS 1.3) with a key it creates in
# DATA_DIR/identity; desktop apps pin its fingerprint, so no domain or certificate is needed.
# Use your own certificate instead (re-read daily, so external renewals apply):
# TLS_CERT_FILE=/etc/letsencrypt/live/chat.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/chat.example.com/privkey.pem
# Plain HTTP normally requires a loopback HOST (npm run server:dev) or an HTTPS
# reverse proxy named in TRUST_PROXY. Keep a proxy backend port private.
# TLS=off
# Terminal overrides: npm run server:http or npm run server:https
# To persist direct HTTP on a LAN/remote address in this file, set BOTH:
# TLS=off
# ALLOW_INSECURE_HTTP=1
# Desktop users must enable "Allow insecure HTTP for this server" at sign-in.
# HTTP exposes credentials, messages and files in transit and cannot verify server identity.
# This does not enable remote HTTP in the browser client.
# If the identity key is lost, the server refuses to start, because every desktop app would
# refuse the new fingerprint. Restore it from a backup, or start once with this set to 1 to
# deliberately create a new identity (members then need a new server link).
# CAMPFIRE_NEW_IDENTITY=1
# Comma-separated additional browser-client origins. Localhost clients are allowed.
CLIENT_ORIGINS=https://chat.example.com
# Provide your own STUN and TURN service for calls across the internet.
# Short-lived TURN credentials are recommended for public hosting.
# STUN-only connectivity test (no media relay):
# ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
ICE_SERVERS=[]

# Trust only the addresses/CIDRs of your reverse proxy; never enable globally.
# Example for a proxy on this same host (leave empty without a proxy):
# TRUST_PROXY=127.0.0.1
TRUST_PROXY=
# Starting attachment storage quota in bytes (1 GiB default). The owner can change it
# under Settings → Server settings, which then applies instead. Existing uploads remain readable
# above the limit; new attachments require free space. Text messages still work.
MAX_STORED_UPLOAD_BYTES=1073741824

# GIF search. Create a free key in the KLIPY Partner Panel (https://partner.klipy.com/);
# test keys allow 100 requests per hour. Members' apps search KLIPY directly with this key
# and load GIFs from KLIPY, so it is shared with signed-in members. Leave empty to hide GIFs.
KLIPY_API_KEY=

# Link previews. The server fetches each linked page once (public internet addresses only)
# to show a card with its title, description and image. Set to off to stop these requests.
LINK_PREVIEWS=on
